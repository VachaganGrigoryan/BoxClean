<?xml version="1.0" encoding="utf-8"?>
<!-- A bento cell: frosted glass over the ambient glow, solid white while focused (like pill_bg). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#24FFFFFF" android:endColor="#0FFFFFFF" />
            <stroke android:width="1dp" android:color="#29FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
