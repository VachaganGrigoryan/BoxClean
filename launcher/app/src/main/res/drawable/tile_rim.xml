<?xml version="1.0" encoding="utf-8"?>
<!-- Bento focus ring over a focused tile's banner: white, with a dark inner line so it shows on white banners too. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="3dp" android:color="#FFFFFFFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:top="3dp" android:left="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <stroke android:width="1.5dp" android:color="#8C000000" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
