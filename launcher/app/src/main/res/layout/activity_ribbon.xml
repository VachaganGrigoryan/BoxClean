<?xml version="1.0" encoding="utf-8"?>
<!-- LG webOS style home (RibbonHome): a blurred full-screen backdrop of the focused app, its name, and one
     ribbon of cards along the bottom. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_bottom" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="56dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_light"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:textColor="#FFFFFFFF"
            android:textSize="40sp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/outfit_regular"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:letterSpacing="0.14"
            android:textAllCaps="true"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="56dp"
        android:layout_marginBottom="176dp"
        android:alpha="0"
        android:fontFamily="@font/outfit_light"
        android:includeFontPadding="false"
        android:letterSpacing="-0.02"
        android:singleLine="true"
        android:textColor="#FFFFFFFF"
        android:textSize="56sp" />

    <HorizontalScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="28dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="40dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ribbon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingTop="28dp" />
    </HorizontalScrollView>
</FrameLayout>
